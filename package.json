{
  "name": "xeto-vscode-extension",
  "description": "Language support for Xeto - provides syntax highlighting, auto-complete, and code navigation for .xeto files",
  "displayName": "Xeto IDE Extension",
  "license": "BSD-3",
  "version": "0.4.5",
  "categories": [],
  "keywords": [
    "multi-root ready"
  ],
  "publisher": "xeto",
  "repository": {
    "url": "https://github.com/xetobase/xeto-vscode-extension"
  },
  "engines": {
    "vscode": "^1.73.0"
  },
  "activationEvents": [
    "onLanguage:xeto"
  ],
  "main": "./client/out/extension",
  "browser": "./client/dist/browserClientMain",
  "contributes": {
    "languages": [
      {
        "id": "xeto",
        "extensions": [
          ".xeto",
          ".xetod"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "axon",
        "aliases": [
          "Axon"
        ]
      }
    ],
    "grammars": [
      {
        "language": "xeto",
        "scopeName": "source.xeto",
        "path": "./syntaxes/xeto.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.svg": "svg",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.js": "javascript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.axon": "axon",
          "meta.embedded.block.md": "markdown"
        }
      },
      {
        "language": "axon",
        "scopeName": "source.axon",
        "path": "./syntaxes/axon.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Xeto",
      "properties": {
        "xeto.libraries.external": {
          "type": "array",
          "default": [],
          "markdownDescription": "A list of locations for external libraries.\nThe entries can be either: \n* strings\n   * this needs to be a path to the local file system that vscode can access\n  * if the folder contains a **lib.xeto** file then it is treated as a single library\n  * if **lib.xeto** is missing, then each folder (just one level deep) is searched and considered a lib if **lib.xeto** exists\n  * anything else is ignored\n* an object that describes the desired library. This is mostly used for **URLs**. The object should have the following structure\n   * **name**: name of the lib\n   * **lib**: URL path to **lib.xeto** file. Version and docs will be read from this\n   * **files**: a string array with the URL to all the files of the lib\n\n Example of a lib entry: \n \n{\n \"name\": \"fakelib\",\n \"lib\": \"https://ex.com/fakelib/lib.xeto\",\n  \"files\": [\n   \"https://ex.com/fakelib/meta.xeto\"\n   \"https://ex.com/fakelib/tags.xeto\"\n ]\n}\n \nIn case of name clashing libraries at **the top** of the array take precedence over libraries of the same name but **lower** in the array."
        }
      }
    },
    "commands": [
      {
        "command": "xeto.showResolvedPath",
        "title": "Xeto: Show Resolved Env Path"
      },
      {
        "command": "xeto.buildCurrentLib",
        "title": "Xeto: Build Current Lib"
      },
      {
        "command": "xeto.resetBuildContext",
        "title": "Xeto: Reset Build Context for Current Lib"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "docLink",
        "superType": "type",
        "description": "Token type for links in docs"
      },
      {
        "id": "dataInstance",
        "superType": "decorator",
        "description": "Data istance"
      },
      {
        "id": "globalTag",
        "superType": "variable",
        "description": "Global tag declaration with * prefix"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "globalTag": [
            "entity.name.global"
          ],
          "docLink": [
            "entity.name.type",
            "markup.underline.link"
          ],
          "dataInstance": [
            "entity.name.type.instance"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b && webpack --mode production --devtool hidden-source-map",
    "compile-web": "webpack --devtool hidden-source-map",
    "watch": "tsc -b -w",
    "lint": "eslint ./client/src ./server/src --ext .ts,.tsx",
    "format": "prettier --ignore-path .gitignore --write \"**/*.ts\"",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "test": "vitest run test/unit test/types test/lsp test/manifest",
    "test:watch": "vitest",
    "test:corpus": "vitest run test/corpus",
    "test:all": "npm run test && npm run test:corpus",
    "test:coverage": "vitest run --coverage",
    "deploy": "vsce publish",
    "extension:build": "vsce package",
    "sandbox:web": "npm run compile-web && vscode-test-web --browserType=chromium --verbose --extensionDevelopmentPath=. ./web-test-data"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "@vitest/coverage-v8": "^3.2.4",
    "assert": "^2.0.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^34.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "https-browserify": "^1.0.0",
    "path-browserify": "^1.0.1",
    "prettier": "2.8.8",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4",
    "url": "^0.11.0",
    "vitest": "^3.2.4",
    "webpack": "^5.79.0",
    "webpack-cli": "^5.0.1"
  }
}
